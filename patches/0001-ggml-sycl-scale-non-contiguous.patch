+// Non-contiguous variant: src and dst are addressed through their byte strides.
+static void scale_f32_nc(const char * x, char * dst, const float scale, const float bias,
+                         const int64_t ne0, const int64_t ne1, const int64_t ne2, const int64_t k,
+                         const size_t s0, const size_t s1, const size_t s2, const size_t s3,
+                         const size_t d0, const size_t d1, const size_t d2, const size_t d3,
+                         const sycl::nd_item<3> &item_ct1) {
+    const int64_t i = (int64_t) item_ct1.get_local_range(2) * item_ct1.get_group(2) + item_ct1.get_local_id(2);
+    if (i >= k) {
+        return;
+    }
+    const int64_t i0 = i % ne0;
+    const int64_t i1 = (i / ne0) % ne1;
+    const int64_t i2 = (i / (ne0 * ne1)) % ne2;
+    const int64_t i3 = i / (ne0 * ne1 * ne2);
+    const float v = *(const float *) (x + i0*s0 + i1*s1 + i2*s2 + i3*s3);
+    *(float *) (dst + i0*d0 + i1*d1 + i2*d2 + i3*d3) = scale * v + bias;
+}
