+static void scale_f32_nc_sycl(const ggml_tensor * src, ggml_tensor * dst, const float scale, const float bias,
+                              queue_ptr stream) {
+    const int64_t k = ggml_nelements(src);
+    const int64_t num_blocks = (k + SYCL_SCALE_BLOCK_SIZE - 1) / SYCL_SCALE_BLOCK_SIZE;
+    const char * x = (const char *) src->data;
+    char * d = (char *) dst->data;
+    const int64_t ne0 = src->ne[0], ne1 = src->ne[1], ne2 = src->ne[2];
+    const size_t s0 = src->nb[0], s1 = src->nb[1], s2 = src->nb[2], s3 = src->nb[3];
+    const size_t d0 = dst->nb[0], d1 = dst->nb[1], d2 = dst->nb[2], d3 = dst->nb[3];
+    stream->parallel_for(
+        sycl::nd_range<3>(sycl::range<3>(1, 1, num_blocks) * sycl::range<3>(1, 1, SYCL_SCALE_BLOCK_SIZE),
+                          sycl::range<3>(1, 1, SYCL_SCALE_BLOCK_SIZE)),
+        [=](sycl::nd_item<3> item_ct1) {
+            scale_f32_nc(x, d, scale, bias, ne0, ne1, ne2, k, s0, s1, s2, s3, d0, d1, d2, d3, item_ct1);
+        });
+}
